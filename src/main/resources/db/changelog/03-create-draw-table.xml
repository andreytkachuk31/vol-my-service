<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="03" author="atkachuk">

        <createTable tableName="draws" remarks="A table to contain all draws">
            <column name="id" autoIncrement="true" type="bigint">
                <constraints nullable="false" unique="true" primaryKey="true"/>
            </column>
            <column name="fundraising_id" type="int">
                <constraints nullable="false" foreignKeyName="fk_draw_fundraising" references="fundraisings(id)" deleteCascade="true"/>
            </column>
            <column name="winner_id" type="int">
                <constraints nullable="false" foreignKeyName="fk_draw_donor" references="donors(id)" deleteCascade="true"/>
            </column>
            <column name="status" type="varchar(255)"/>
            <column name="prize" type="varchar(255)"/>
            <column name="draw_date" type="date"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
