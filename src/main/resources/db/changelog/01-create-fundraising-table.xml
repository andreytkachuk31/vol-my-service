<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="01" author="atkachuk">

        <createTable tableName="fundraisings" remarks="A table to contain all fundraisings">
            <column name="id" autoIncrement="true" type="bigint">
                <constraints nullable="false" unique="true" primaryKey="true"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(255)"/>
            <column name="image" type="varchar(255)"/>
            <column name="tag" type="varchar(255)"/>
            <column name="status" type="varchar(255)"/>
            <column name="progress_percent" type="int"/>
            <column name="current_sum" type="double"/>
            <column name="total_sum" type="double"/>
            <column name="start_date" type="date"/>
            <column name="end_date" type="date"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
